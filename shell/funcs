# vi: filetype=sh

# Clone a whole github organization into ./ORG.
orgclone() {
  gh repo list "$1" --limit 1000 --json name --jq '.[].name' |
    while read -r repo; do
      [ -d "$1/$repo" ] || gh repo clone "$1/$repo" "$1/$repo"
    done
}

# Start a zellij session with a random built-in theme: zr [dark|light] [session-name].
# Only this session is themed (zellij options --theme); config.kdl is left alone.
# ZR_QUIT=1 ends the session when its terminal is closed (default: it detaches and lingers).
# With kanji on PATH, the session uses zellij/layouts/kanji.kdl: a random kanji in each new tab.
zr() {
  local dark=(ayu-dark ayu-mirage blade-runner catppuccin-frappe catppuccin-macchiato catppuccin-mocha
    cyber-noir dracula everforest-dark flexoki-dark gruber-darker gruvbox-dark iceberg-dark kanagawa
    lucario menace molokai-dark night-owl nightfox nord one-half-dark onedark retro-wave solarized-dark terafox
    tokyo-night tokyo-night-dark tokyo-night-storm vesper)
  local light=(ayu-light catppuccin-latte dayfox default-light everforest-light gruvbox-light
    iceberg-light pencil-light solarized-light tokyo-night-light)
  local pool theme layout=()
  case "${1:-}" in
    dark) pool=("${dark[@]}"); shift ;;
    light) pool=("${light[@]}"); shift ;;
    *) pool=("${dark[@]}" "${light[@]}") ;;
  esac
  theme="${pool[RANDOM % ${#pool[@]}]}"
  echo "zellij theme: $theme"
  command -v kanji >/dev/null && layout=(--new-session-with-layout kanji)
  # zellij 0.45 keeps re-announcing itself (DCS 2666) until a host zellij acks; Terminal.app
  # prints those as base64 junk at the prompt. 0 keeps only the first one, which the first frame wipes.
  ZELLIJ_NESTED_MAX_UNACKED_ANNOUNCES=0 zellij ${1:+--session "$1"} "${layout[@]}" options --theme "$theme" ${ZR_QUIT:+--on-force-close quit}
}
