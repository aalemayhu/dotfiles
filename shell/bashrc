# vi:syntax=sh
#
# Interactive bash. Login shells get here through ~/.bash_profile.
# Machine-specific settings and secrets go in ~/.shell/local (not in git).

. "$HOME/.shell/.env"
. "$HOME/.shell/.aliases"
. "$HOME/.shell/.funcs"

# History: large, written after every command, no duplicates
HISTSIZE=100000
HISTFILESIZE=100000
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend
PROMPT_COMMAND="history -a${PROMPT_COMMAND:+; $PROMPT_COMMAND}"

shopt -s checkwinsize
# bash 4+ only (macOS /bin/bash is 3.2, Homebrew's is current)
shopt -s autocd globstar 2>/dev/null

# git completion ships with Homebrew's git (or the distro's on Linux)
for _git_completion in "${HOMEBREW_PREFIX:-/opt/homebrew}/etc/bash_completion.d/git-completion.bash" \
    /usr/share/bash-completion/completions/git; do
    [ -r "$_git_completion" ] && { . "$_git_completion"; break; }
done
unset _git_completion

# mise: per-directory node/java/... versions (replaces nvm and sdkman)
command -v mise >/dev/null && eval "$(mise activate bash)"
# fzf: Ctrl-R fuzzy history, Ctrl-T file picker, Alt-C cd
command -v fzf >/dev/null && eval "$(fzf --bash)"
# zoxide: `z foo` jumps to the most used directory matching foo
command -v zoxide >/dev/null && eval "$(zoxide init bash)"
# starship prompt (git branch/status, runtime versions, exit codes)
command -v starship >/dev/null && eval "$(starship init bash)"

[ -f "$HOME/.shell/local" ] && . "$HOME/.shell/local"
# vi:syntax=sh
#
# Every interactive terminal starts in its own zellij session with a random theme (see zr in
# .funcs). Skipped inside zellij/tmux/nvim, over ssh, in IDE terminals, without zellij, or when
# NO_ZELLIJ is set. Exiting zellij drops back to a plain shell; closing the terminal ends the session.
if [[ $- == *i* && -t 0 && -t 1 && "${TERM:-dumb}" != dumb ]] &&
    [[ -z "${ZELLIJ:-}${TMUX:-}${NVIM:-}${NO_ZELLIJ:-}${SSH_CONNECTION:-}${INSIDE_EMACS:-}" ]] &&
    [[ "${TERM_PROGRAM:-}" != vscode ]] && command -v zellij >/dev/null; then
    ZR_QUIT=1 zr
fi
