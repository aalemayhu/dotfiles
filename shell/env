# vi:syntax=sh
#
# Environment for every bash, login or not. Sourced by .bashrc.

export VISUAL=nvim
export EDITOR=nvim

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# Homebrew: PATH, MANPATH and HOMEBREW_PREFIX
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"

# mise shims, so tools it manages (node, java, ...) also work in
# non-interactive shells. Interactive shells use `mise activate` (.bashrc).
export PATH="$HOME/.local/share/mise/shims:$PATH"

# Own scripts, claude, nvim (~/.local/bin) and rustup (~/.cargo/bin)
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$HOME/Scripts:$PATH"
