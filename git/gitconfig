# Shared git config. ~/.gitconfig is a local file that includes this one, so
# `git config --global` (gh, installers) writes there and never touches the repo.

[user]
        email = alexander@alemayhu.com
        name = Alexander Alemayhu

[core]
        editor = nvim
        abbrev = 12
[init]
        defaultBranch = main
[alias]
        ci = commit
        st = status
        br = branch
        ch = checkout
        clf = clean -fd
        l = log --oneline
        p = pull
        ss = status -s
        forget = rm --cached
        unstage = reset HEAD --
        ll = !git --no-pager log -1 --pretty='tformat:%h (%s, %ad)' --date=short

[color]
        branch = auto
        diff = auto
        status = auto

[color "branch"]
        current = yellow reverse
        local = yellow
        remote = green

[color "diff"]
        meta = yellow bold
        frag = magenta bold
        old = red
        new = cyan

[color "status"]
        added = yellow
        changed = green
        untracked = cyan
[push]
        # push the current branch to its upstream, creating it on first push
        default = simple
        autoSetupRemote = true
[fetch]
        prune = true
[pull]
        rebase = true
[rebase]
        autoStash = true
[rerere]
        # remember conflict resolutions and replay them
        enabled = true
[merge]
        conflictStyle = zdiff3
[diff]
        algorithm = histogram
        colorMoved = default
        renames = true
        renameLimit = 2000
[log]
        decorate = auto
[checkout]
        defaultRemote = origin

[pager]
        status = false
        branch = false
[format]
        signoff = true
[advice]
        diverging = false

# GitHub over HTTPS authenticates through gh (`gh auth login`)
[credential "https://github.com"]
        helper =
        helper = !gh auth git-credential
[credential "https://gist.github.com"]
        helper =
        helper = !gh auth git-credential
