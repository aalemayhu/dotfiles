// Only what differs from zellij's defaults; `zellij setup --dump-config` shows the rest.

keybinds {
    // Ctrl h belongs to nvim (zellij-nav.nvim), so move mode is on Alt m instead
    unbind "Ctrl h"
    shared_except "locked" "move" {
        bind "Alt m" { SwitchToMode "move"; }
    }
    move {
        bind "Alt m" { SwitchToMode "normal"; }
    }
    shared {
        bind "Ctrl PageUp" { GoToPreviousTab; }
        bind "Ctrl PageDown" { GoToNextTab; }
    }
    shared_except "locked" {
        // Ctrl q asks first: a small floating prompt, y quits (kills this session), anything else cancels
        bind "Ctrl q" {
            Run "bash" "-c" r#"printf '\n  Quit zellij? [y/N] '; read -rsn1 k; [[ $k == [yY] ]] && zellij kill-session "$ZELLIJ_SESSION_NAME""# {
                floating true
                close_on_exit true
                name "quit"
                x "35%"
                y "40%"
                width "30%"
                height "5"
            }
        }
    }
}

// The default aliases plus autolock (installed by bootstrap.sh)
plugins {
    tab-bar location="zellij:tab-bar"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    compact-bar location="zellij:compact-bar"
    session-manager location="zellij:session-manager"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
    filepicker location="zellij:strider" {
        cwd "/"
    }
    configuration location="zellij:configuration"
    plugin-manager location="zellij:plugin-manager"
    about location="zellij:about"
    // locks zellij while nvim runs so <C-h/j/k/l> reach zellij-nav.nvim
    autolock location="file:~/.config/zellij/plugins/zellij-autolock.wasm" {
        is_enabled true
        lock_regex "(^|/)n?vim( .*)?$"
        ignore_regex "^$"
    }
}

load_plugins {
    "zellij:link"
    autolock
}

// zr (shell/funcs) picks a random theme per session; this is for plain `zellij`
theme "pencil-light"

// closing the terminal ends the session instead of leaving it detached
on_force_close "quit"

show_startup_tips false
