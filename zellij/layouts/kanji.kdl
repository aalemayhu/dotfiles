// The default layout plus a random kanji (kanji/kanji) in a floating pane that closes
// on Enter, in the first tab and in every new one. Used by zr in shell/funcs.
// Floating panes in default_tab_template are ignored, hence the explicit tab and new_tab_template.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }
    tab {
        pane
        floating_panes {
            pane name="漢字" command="kanji" close_on_exit=true x="15%" y="10%" width="70%" height="80%"
        }
    }
    new_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        pane
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
        floating_panes {
            pane name="漢字" command="kanji" close_on_exit=true x="15%" y="10%" width="70%" height="80%"
        }
    }
}
